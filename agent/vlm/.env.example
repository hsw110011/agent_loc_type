# 环境变量示例，不自动加载；含义与默认值见 agent/vlm/README.md。
VLM_BASE_URL=http://127.0.0.1:8011/v1
VLM_MODEL=local-qwen
VLM_TIMEOUT=1800
VLM_MAX_TOKENS=1024
VLM_MAX_IMAGES=4
VLM_MAX_IMAGE_PIXELS=1048576
# 留空；自动启动的本机服务不配置认证
VLM_API_KEY=
VLM_AUTOSTART=1
VLM_START_TIMEOUT=900
# EXL3 服务（agent/vlm/exl3_server.py），与 Agent 共用项目 .venv
VLM_MAX_NUM_SEQS=5
# VLM_CACHE_TOKENS=73728  # 四路及以上默认 73728；一至三路默认 32768
VLM_CACHE_BITS=3
VLM_MAX_MODEL_LEN=32768
# VLM_MODEL_ROOT=qwen3827b-exl3-dflash2
# VLM_MODEL_PATH=qwen3827b-exl3-dflash2/models/qwen38-27b-exl3
# VLM_DRAFT_PATH=none  # 并行时默认关闭；串行时默认使用配套 DFlash2
# VLM_AUTOSTART=0 时复用手动部署的服务，需自行确认它是 exl3_server 及其生命周期。
