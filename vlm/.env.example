# 与项目已有 .env 隔离；使用前 export，或 set -a; source vlm/.env.example; set +a
VLM_BASE_URL=http://127.0.0.1:8011/v1
VLM_MODEL=local-qwen
VLM_TIMEOUT=180
VLM_MAX_TOKENS=1024
VLM_MAX_IMAGES=4
VLM_MAX_IMAGE_PIXELS=1048576
# 本机无认证服务无需密钥。不要设置云端 OPENAI_API_KEY。
VLM_API_KEY=
# 启动配置；不填写模型路径则使用项目下 qwen_3.5_9b
VLM_MAX_MODEL_LEN=17584
VLM_GPU_MEMORY_UTILIZATION=0.65
VLM_MAX_NUM_SEQS=2
VLM_MAX_BATCHED_TOKENS=2048
VLM_AUTOSTART=1
VLM_START_TIMEOUT=600
# PROJECT_PYTHON 默认使用项目 .venv-vllm/bin/python；加载时 TorchAO INT8 W8A16。
# VLM_AUTOSTART=0 时复用手动部署的服务，需自行确认量化和生命周期。

# Agent / PathFinder / VLM 共用一个环境，默认路径由启动脚本推导。
# PROJECT_PYTHON=.venv-vllm/bin/python
# VLM_MODEL_PATH=qwen_3.5_9b
# 相对路径固定按项目根目录解析。
